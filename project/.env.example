# MongoDB connection string
DB_URL = mongodb://127.0.0.1:27017/MemeMory?readPreference=primary&ssl=false
PORT = 5000

# JWT settings - use a long random secret in production
EXPIRY_DATE = 7d
SECRET_KEY = "change-me"

# Set to production to send the login cookie only via HTTPS
# NODE_ENV = production

# Maximum number of players a multiplayer room can be set to (2-16, default 8)
# MULTIPLAYER_MAX_PLAYERS = 8

# Secret address of the hidden jackpot (default: /🤫🎰💸), and its secret word
# JACKPOT_PATH = 🤫🎰💸
# JACKPOT_SECRET = moneyrain

# Admin panel: secret address (default: /🛠️🦆) and password. Without ADMIN_PASSWORD there is no admin panel.
# ADMIN_PATH = 🦆🔧
# ADMIN_PASSWORD = "choose-a-long-password"   (in quotes if it has a # in it)
# ... or only a hash of it (made with: npm run admin-password)
# ADMIN_PASSWORD_HASH = scrypt:...

# Telegram bot (@ptfast_bot): the csgofast season ranking as a pinned message, checked every minute.
# Off for now: it only runs with TELEGRAM_BOT_ENABLED = true and the token. The chat: TELEGRAM_CHAT_ID - or the first
# chat that sends /start to the bot.
# TELEGRAM_BOT_ENABLED = true
# TELEGRAM_BOT_TOKEN = 123456:ABC...
# TELEGRAM_CHAT_ID = 123456789
# TELEGRAM_POLL_MINUTES = 1
# TELEGRAM_EUR_RATE = 0.57
# TELEGRAM_PLACES = 15
# TELEGRAM_HIGHLIGHT = FlaveDrake,duck.
# CSGOFAST_TOP_URL = https://back-new.csgofast.com/api/motivator/seasons-top?limit=15
